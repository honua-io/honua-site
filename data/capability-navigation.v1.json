      "description": "Spatial data, edits, query statistics, analytics, and native spatial output.",
      "status": "",
      "source": "https://github.com/honua-io/honua-server/blob/e6271fd35ffb7b77779438fd853fe14cc067130c/docs/reference/configuration/data-sources/postgis.md"
    },
    {
      "title": "SQL Server",
      "access": "Read/query",
      "href": "https://docs.honua.io/server/reference/configuration/data-sources/sql-server",
      "description": "Serve geometry and geography tables from an existing database.",
      "status": "",
      "source": "https://github.com/honua-io/honua-server/blob/e6271fd35ffb7b77779438fd853fe14cc067130c/docs/reference/configuration/data-sources/sql-server.md"
    },
    {
      "title": "DuckDB",
      "access": "Read-only",
      "href": "https://docs.honua.io/server/reference/configuration/data-sources/duckdb",
      "description": "Embedded analytical and reference data without another database service.",
      "status": "",
      "source": "https://github.com/honua-io/honua-server/blob/e6271fd35ffb7b77779438fd853fe14cc067130c/docs/reference/configuration/data-sources/duckdb.md"
    },
    {
      "title": "MySQL / MariaDB",
      "access": "Read/query",
      "href": "https://docs.honua.io/server/reference/configuration/data-sources/mysql-mariadb",
      "description": "Serve existing spatial tables through the provider’s query interface.",
      "status": "",
      "source": "https://github.com/honua-io/honua-server/blob/e6271fd35ffb7b77779438fd853fe14cc067130c/docs/reference/configuration/data-sources/mysql-mariadb.md"
    },
    {
      "title": "Oracle",
      "access": "Read/query",
      "href": "https://docs.honua.io/server/reference/configuration/data-sources/oracle",
      "description": "SDO_GEOMETRY support; use a non-Native-AOT build.",
      "status": "Experimental",
      "source": "https://github.com/honua-io/honua-server/blob/e6271fd35ffb7b77779438fd853fe14cc067130c/docs/reference/configuration/data-sources/oracle.md"
