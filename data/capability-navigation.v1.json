  "formatGroups": [
    {
      "id": "cloud-vector",
      "title": "Cloud-native feature data",
      "summary": "Compact formats for analytical datasets and query results.",
      "source": "https://github.com/honua-io/honua-server/blob/e9b53d0fc0dc72f3ed5887112ab90f43f6d39862/docs/reference/protocols/cloud-native-formats.md",
      "items": [
        {
          "title": "GeoParquet",
          "role": "File import · query output",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        },
        {
          "title": "GeoArrow / Arrow IPC",
          "role": "Query output · spatial columnar data",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        },
        {
          "title": "FlatGeobuf",
          "role": "File import · query output",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        }
      ]
    },
    {
      "id": "cloud-tiles",
      "title": "Cloud imagery & tile archives",
      "summary": "Publish imagery and tiles from files or object storage.",
      "source": "https://github.com/honua-io/honua-server/blob/e9b53d0fc0dc72f3ed5887112ab90f43f6d39862/docs/reference/protocols/cloud-native-formats.md",
      "items": [
        {
          "title": "COG / GeoTIFF",
          "role": "Raster import · registered cloud tile sources",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        },
        {
          "title": "PMTiles",
          "role": "Archive · publish · serve with HTTP ranges",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        },
        {
          "title": "MVT / TileJSON",
          "role": "Vector tiles · tile source metadata",
          "href": "https://docs.honua.io/server/reference/protocols/vector-tiles"
        }
      ]
    },
    {
      "id": "datacubes",
      "title": "Multidimensional & scientific data",
      "summary": "Register datacubes or convert scientific sources for coverage access.",
      "source": "https://github.com/honua-io/honua-server/blob/e9b53d0fc0dc72f3ed5887112ab90f43f6d39862/docs/reference/protocols/cloud-native-formats.md",
      "note": "NetCDF4, HDF5, and GRIB use the documented GDAL-to-Zarr path and require a reader-enabled build. Coverage release scope remains separate.",
      "items": [
        {
          "title": "Zarr v2 / v3",
          "role": "Store registration · coverage subsets",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        },
        {
          "title": "NetCDF4 / HDF5",
          "role": "URL registration · conversion to Zarr",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        },
        {
          "title": "GRIB / GRIB2",
          "role": "URL registration · conversion to Zarr",
          "href": "https://docs.honua.io/server/reference/protocols/cloud-native-formats"
        }
      ]
    },
    {
      "id": "vector-files",
      "title": "Vector & tabular files",
