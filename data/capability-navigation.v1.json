    {
      "title": "Snowflake",
      "access": "Read/query",
      "href": "https://docs.honua.io/server/reference/configuration/data-sources/snowflake",
      "description": "Read spatial warehouse tables; use a non-Native-AOT build.",
      "status": "Experimental",
      "source": "https://github.com/honua-io/honua-server/blob/e6271fd35ffb7b77779438fd853fe14cc067130c/docs/reference/configuration/data-sources/snowflake.md"
